<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.dao.WeChatInformationMapper">

    <select id="wechatInformation" resultType="com.example.springboot.entity.WeChatUsers">
        SELECT * FROM wechat_users
        WHERE phone=#{phone};
    </select>

</mapper>


