<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.dao.TemplateManageMapper">

    <select id="addQuestionTemplate">
        INSERT INTO question_template(id,questionTemplate,preciseQuestion)
        VALUES (#{id},#{template},#{preciseQuestion})
    </select>
    <select id="removeQuestionTemplate">
        DELETE FROM question_template
        WHERE questionTemplate = #{template}
    </select>
    <select id="removeTemplateByQuestion">
        DELETE FROM question_template
        WHERE preciseQuestion = #{question}
    </select>
    <select id="changeQuestionTemplate">
        UPDATE question_template
        SET questionTemplate = #{newTemplate}
        WHERE questionTemplate = #{oldTemplate}
          AND id = #{questionId}
    </select>
    <select id="changePreciseQuestion">
        UPDATE question_template
        SET preciseQuestion = #{newQuestion}
        WHERE id = #{questionId}
    </select>
    <select id="countTemplate" resultType="int">
        SELECT COUNT(*) FROM question_template
    </select>
    <select id="getTemplate" resultType="com.example.springboot.entity.QuestionTemplate">
        SELECT * FROM question_template
        LIMIT #{start},#{number}
    </select>
    <select id="findAllTemplate" resultType="com.example.springboot.entity.QuestionTemplate">
        SELECT * FROM question_template
    </select>

</mapper>


