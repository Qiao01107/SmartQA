<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.dao.WeChatChattingMapper">

    <select id="wechatChatting" resultType="com.example.springboot.entity.Chatting">
        SELECT * FROM chatting
        WHERE phone=#{phone};
    </select>
    <select id="addChatting">
        INSERT INTO chatting(phone,speaker,content,speakDate) VALUES(#{phone},#{speaker},#{content},#{time});
    </select>
    <select id="clearHistory">
        DELETE FROM chatting
        WHERE phone=#{phone};
    </select>

</mapper>


