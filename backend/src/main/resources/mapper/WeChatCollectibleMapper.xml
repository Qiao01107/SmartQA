<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.dao.WeChatCollectibleMapper">

    <select id="findCollection" resultType="com.example.springboot.entity.UserCollectible">
        SELECT * FROM user_collectible;
    </select>
    <select id="collectible" resultType="com.example.springboot.entity.UserCollectible">
        SELECT * FROM user_collectible
        WHERE phone=#{phone};
    </select>
    <select id="addCollectible">
        INSERT into user_collectible(phone,question,reply,collectDate) VALUES(#{phone},#{question},#{reply},#{time});
    </select>
    <select id="removeCollectible">
        DELETE FROM user_collectible
        WHERE phone=#{phone} AND question=#{question} AND reply=#{reply};
    </select>

</mapper>


