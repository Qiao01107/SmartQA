# ============================================================
# SmartQA 环境变量模板（不含任何真实凭据，可安全提交 Git）
# 使用：复制为 .env 并填入真实值。.env 已被 .gitignore 排除。
# ============================================================

# ---------- MySQL ----------
DB_USER=root
DB_PASSWORD=请填写本地MySQL密码

# ---------- Neo4j ----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写Neo4j密码

# ---------- JWT 鉴权（本轮新增，必填） ----------
# HS256 签名密钥，至少 32 字节；泄露即等于任何人都能伪造登录令牌。
# 生成方式：openssl rand -base64 48  或  python -c "import secrets;print(secrets.token_urlsafe(48))"
# 未配置时后端仍可启动，但会生成一次性随机密钥并打印 WARN：进程重启后所有令牌立即失效。
JWT_SECRET=请填写至少32字节的随机字符串
# 令牌有效期（分钟），默认 30，上限 120。短有效期用于压缩令牌泄露后的可用窗口。
JWT_TTL_MINUTES=30

# ---------- 允许跨域的前端源（逗号分隔） ----------
# 生产环境请改成实际前端域名；本地 Vite dev server 已有代码默认值。
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ---------- 初始超级管理员（仅在 web_user 表为空时创建一次） ----------
# 密码以 BCrypt 哈希落库（不保存明文）。此处的值仅用于首次初始化，不会覆盖已有账号。
# 安全要求：至少 8 位且同时包含字母和数字；admin/admin、12345678 等弱口令会被拒绝，
# 此时**不会创建任何管理员**（fail-closed），请在服务端日志中确认初始化结果。
INIT_ADMIN_ACCOUNT=admin
INIT_ADMIN_PASSWORD=请填写强密码（至少8位，含字母和数字）
INIT_ADMIN_NAME=超级管理员
INIT_ADMIN_PHONE=13800000000

# ---------- 可选：HanLP 数据 ----------
# HANLP_ROOT=./hanlp-data
# HANLP_FUZZY_WORDS=hanlp-data/fuzzyWords.txt

# ---------- 可选：榛子云短信（忘记密码功能） ----------
# 未配置时“忘记密码”fail-closed：不签发验证码，直接提示短信服务未配置。
# ZHENZI_SMS_APP_ID=
# ZHENZI_SMS_APP_SECRET=
# ZHENZI_SMS_TEMPLATE_ID=7385
