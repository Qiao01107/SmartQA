<!--pages/community/community.wxml-->


<scroll-view scroll-y scroll-into-view='{{toView}}' style='height: {{scrollHeight}}; width: 100%;'>


  <!-- 这里是开头的热搜消息 -->
  <view style='display: flex; padding: 2vw 11vw 2vw 2vw;'>
    <view style='width: 11vw; height: 11vw;'>
      <image style='width: 11vw; height: 11vw; border-radius: 10rpx;' src='../../icons/0650DF812ED2DB105A4808F124494662.png'></image>
    </view>
    <view style='width: 4vw; height: 11vw; margin-left: 0.5vw; display: flex; align-items: center; z-index: 9;'>
    </view>
    <view class='leftMsg'>欢迎，这里是智能问答机器人！下面给您推荐几个热搜问题:</view>
  </view>
  <view style='display: flex; padding: 0vw 11vw 2vw 2vw;line-height: 1.5em;'>
    <view style='width: 15vw; height: 11vw; margin-left: 0.5vw; display: flex; align-items: center; z-index: 9;'>
    </view>

    <view wx:if="{{hotyes == 1}}" class="leftMsg" style="line-height: 1.5em;">
      <view class="hotques" bindtap="sethotnum0" style="background-color: rgb(189, 255, 224);border-radius: 10rpx;">NO1. {{hotques0}}</view>
      <view style=' height: 2vw;'></view>
      <view class="hotques" bindtap="sethotnum1" style="background-color: rgb(189, 255, 224);border-radius: 10rpx;">NO2. {{hotques1}}</view>
      <view style=' height: 2vw;'></view>
      <view class="hotques" bindtap="sethotnum2" style="background-color: rgb(189, 255, 224);border-radius: 10rpx;">NO3. {{hotques2}}</view>
      <view style=' height: 2vw;'></view>
      <view class="hotques" bindtap="sethotnum3" style="background-color: rgb(189, 255, 224);border-radius: 10rpx;">NO4. {{hotques3}}</view>
    </view>
  </view>


  <view wx:if="{{hotnum != -1 && sendornot == 1}}">
    <view id='msg-{{index}}' style='display: flex; justify-content: flex-end; padding: 2vw 2vw 2vw 11vw;'>
      <view class='rightMsg'>{{item.content}}</view>
      <view style='width: 4vw; height: 11vw; margin-right: 0.5vw; display: flex; flex-wrap: wrap; align-items: center; z-index: 9;'>
      </view>
      <open-data style='width: 11vw; height: 11vw; border-radius: 10rpx;' type="userAvatarUrl"></open-data>
    </view>
    
    <view  class="renewhotnum" id='msg-{{index}}' style='display: flex; padding: 2vw 11vw 2vw 2vw;'>
      <view style='width: 11vw; height: 11vw;'>
        <image style='width: 11vw; height: 11vw; border-radius: 10rpx;' src='../../icons/0650DF812ED2DB105A4808F124494662.png'></image>
      </view>
      <view style='width: 4vw; height: 11vw; margin-left: 0.5vw; display: flex; align-items: center; z-index: 9;'>
      </view>
      
      <view class='leftMsg'>{{item.content}}</view>
    </view>
  </view>


  <!-- <view class='scrollMsg'> -->
  <block wx:key="key" wx:for='{{msgList}}' wx:for-index="index">

    <!-- 单个消息1 用户发出（右） -->
    <view wx:if='{{item.speaker=="customer"}}' id='msg-{{index}}' style='display: flex; justify-content: flex-end; padding: 2vw 2vw 2vw 11vw;'>
      <view class='rightMsg'>{{item.content}}</view>
      <view style='width: 4vw; height: 11vw; margin-right: 0.5vw; display: flex; flex-wrap: wrap; align-items: center; z-index: 9;'>
      </view>
      <open-data style='width: 11vw; height: 11vw; border-radius: 10rpx;' type="userAvatarUrl"></open-data>
    </view>

    <!-- 单个消息2 客服发出（左） -->
    <view wx:else if='{{item.speaker=="server"}}' id='msg-{{index}}' style='display: flex; padding: 2vw 11vw 2vw 2vw;'>
      <view style='width: 11vw; height: 11vw;'>
        <image style='width: 11vw; height: 11vw; border-radius: 10rpx;' src='../../icons/0650DF812ED2DB105A4808F124494662.png'></image>
      </view>
      <view style='width: 4vw; height: 11vw; margin-left: 0.5vw; display: flex; align-items: center; z-index: 9;'>

      </view>
      <view class='leftMsg'>{{item.content}}</view>
      <!-- <view style="padding: 2vw 2vw;font-size: 35rpx;"> -->
      <!-- <image style='width: 6vw; height: 6vw; border-radius: 10rpx;' src='../../icons/collect2.png'></image>  -->
      <!-- </view> -->
    </view>

    <!-- 收藏部分，先判断答案是否被收藏，再选择图标和点击事件 -->
    
    <view wx:if='{{item.speaker=="server"}}' class="indexcollect" data-indexnumber="{{index}}" id='msg-{{index}}' style='display: flex; padding: 0vw 11vw 2vw 2vw;'>

      <view style='width: 15vw; height: 1vw; margin-left: 0.5vw; display: flex; align-items: center; z-index: 9;'>
      </view>

      <image wx:if="{{collect[index]==0}}" bindtap="doCollect" data-nownumber="{{index}}" style='width: 6vw; height: 6vw; border-radius: 10rpx;' src='../../icons/collect2.png'>
      </image>

      <image wx:else if="{{collect[index]==1}}" bindtap="doCollect" data-nownumber="{{index}}" style='width: 6vw; height: 6vw; border-radius: 10rpx;' src='../../icons/collected.png'>
      </image>

    </view>
    <!-- mark:nowid="{{item.id}}" -->

  </block>
  <!-- </view> -->


  <!-- 占位 -->
  <view style='width: 100%; height: 20vw;'></view>
</scroll-view>
<!-- 下方输入法图标以及键盘输入 -->
<view wx:if="{{nowInput == 1}}" class='inputRoom' >
  <image bindtap="inputchange" style='width: 8vw; margin-left: 3.2vw;' src='../../icons/c2.png' mode='widthFix'></image>
  <input bindinput="question" bindconfirm='sendClick' value='{{inputVal}}' confirm-type='send' bindfocus='focus' bindblur='blur' style="width: 80%; height:initial; display: block; box-sizing: border-box"></input>
</view>
<!-- 语音输入部分 -->
<view wx:elif="{{nowInput == 2}}" class='inputRoom' style='bottom: {{VoiceInput}}'>
  <image bindtap="inputchange" style='bottom: 0; width: 8vw; margin-left: 3.2vw;' src='../../icons/text.png' mode='widthFix'></image>
  <button class="saybutton" type="primary" bindtouchstart="start_say" bindtouchend="end_say" style="width: 80%; height: min-content; display: block;font-size: small; box-sizing: border-box">按住这里说话</button>
</view>
<!-- 发送识别出来的文字的界面 -->
<view wx:elif="{{nowInput == 3}}" class='result' style='height: 80vw;'>
  <view style="height: 70%;padding: 2vw 2vw 2vw 2vw;">
    {{voiceResult}}
    <button bindtap="resay" value='{{inputVal}}' style="top: 60%">重说一遍</button> 
    <button bindtap="send" value='{{inputVal}}' style="top: 65%" >点击发送</button>
  </view>
</view>