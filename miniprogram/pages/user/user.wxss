/* pages/user/my/my.wxss */

page{
    background: #f5f5f5;
  }
  
  .container{
    width: 100%;
    height: 100%;
    background: #f9f9f9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0px;
    box-sizing: border-box;
  }
  
  .user{
    height: 120px;
    width: 98%;
    display: flex;
    flex-direction: row;
    background: #68caf1;
    border-radius: 10px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }
  
  .name{
    width: 60%;
    height: 80px;
    margin-top: 40px;
    padding-left: 20px;
    display: flex;
    color: #f9f9f9;
    font-size: 26px;
  }
  
  .gender{
    width: 40x;
    height: 90px;
    display: flex;
    align-items: center;
    justify-items: center;
    margin-top: 18px;
  }
  .gender image{
    width: 30px;
    height: 30px;
  }
  
  .identity{
    width: 40x;
    height: 90px;
    display: flex;
    align-items: center;
    justify-items: center;
    margin-left: 20px;
    margin-top: 18px;
  }
  .identity image{
    width: 30px;
    height: 30px;
  }
  
  .gif{
    width: 98%;
    height: 20px;
    background: #68caf1;
    position: relative;
    overflow-x: hidden;
  }
  
  .gif image{
    position: absolute;
    width: 100%;
    bottom: 0;
    left: 0;
    z-index: 99;
    mix-blend-mode: screen;
    height: 100rpx;
  }
  
  .process{
    background: #f3f3f3;
    width: 98%;
    height: 100%;
    display: flex;
    flex-direction: column;
    margin-top: 25px;
    border-radius: 7px;
  }
  
  .item{
    height: 70px;
    width: 98%;
    display: flex;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 1%;
    background: #f9f9f9;
  }
  .icon{
    width: 50px;
    height: 70px;
    display: flex;
    align-items: center;
    margin-left: 10px;
  }
  .icon image{
    width: 30px;
    height: 30px;
  }
  
  .box{
    display: flex;
    align-items: center;
    font-size: 20px;
    color: rgb(59, 59, 59);
  }

  .userinfo-avatar {
    overflow:hidden;
    display: block;
    width: 80px;
    height: 70px;
    margin: 50rpx;
    margin-top: 50rpx;
    border-radius: 10%;
    border: 2px solid #fff;
    box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.3);
  }

  .btn1 {
    width: 100%;
    background-color: #68CAF1;
    color: white;
    border-radius: 98rpx; 
    position:center;
    bottom:0;
    font-weight: 600;
  }