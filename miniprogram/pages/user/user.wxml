<!--pages/user/my/my.wxml-->
<view class="container">
  
  <view class="user"  >
      <open-data class="userinfo-avatar" type="userAvatarUrl" ></open-data>
      <open-data class="name" type="userNickName"></open-data>
      <view class="gender">
        <image style="margin-right:20px;" wx:if="{{userGender == 'f'}}" src="../../icons/f.png" />
        <image style="margin-right:20px;" wx:if="{{userGender == 'm'}}" src="../../icons/m.png" />
      </view>
    </view>
  <view class="gif" >   
    <image class="gif-wave" src="../../icons/bg_wave.gif" />
  </view>
  

  <view class="process" >
    <view class="item"  hover-class="search-hover" bindtap="openPage" >
      <view class="icon">
        <image src="../../icons/history.png" />
      </view>
      <view class="box">问题搜索历史</view>
    </view>
    
    <view class="item" bindtap="openPage2" hover-class="search-hover" >
      <view class="icon">
        <image src="../../icons/collect.png" />
      </view>
      <view class="box">我的收藏</view>
    </view>

    <view class="item" bindtap="openPage3" hover-class="search-hover" >
      <view class="icon">
        <image src="../../icons/changepw.png" />
      </view>
      <view class="box">修改密码</view>
    </view>

    <view class="item" bindtap="openPage4"  hover-class="search-hover" >
      <view class="icon">
        <image src="../../icons/feedback.png" />
      </view>
      <view class="box">对回答不满意</view>
    </view>

  </view>
<button class="btn1" open-type='feedback' style="margin-top: 20px;">意见反馈</button>
</view>
<button class="btn1" bindtap="out">退出</button>