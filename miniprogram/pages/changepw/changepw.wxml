<!--pages/changepw/changepw.wxml-->
<view class='container'>
  <form>
    <view class='top'>
      <view class='one_list'>
      <view class=''>旧密码：</view>
        <view class='change'>
          <view>
            <input placeholder="请输入旧密码" maxlength='20' bindinput='oldpasswordInput' maxlength="15"></input>
          </view>
        </view>
      </view>
      <view class='x_line'></view>
      <view class='one_list'>
        <view class='change'>
          <view class=''>新密码：</view>
          <view>
            <input placeholder="新密码(长度6~15样式不限)" maxlength='20' bindinput='newpasswordInput' maxlength="15"></input>
          </view>
        </view>
      </view>
      <view class='x_line'></view>
      <view class='one_list'>
        <view class='change'>
          <view class=''>确认密码：</view>
          <view>
            <input placeholder="请再次输入新密码" maxlength='20' bindinput='confirmpasswordInput' maxlength="15"></input>
          </view>
        </view>
      </view>
    </view>

    <view class='btn' bindtap="change">确定</view>

  </form>
</view>
