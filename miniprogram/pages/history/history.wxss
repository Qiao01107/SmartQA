/* pages/user/history/history.wxss */
page{
  background: #f5f5f5;
}

.container{
  width: 100%;
  height: 100%;
  background: #f9f9f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  box-sizing: border-box;
}

.explain{
  height: 54px;
  width: 98%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: #68caf1;
  color: #ffffff;
  border-radius: 5px;
}

.historyBox{
  width: 98%;
  display: flex;
  flex-direction: column;
  background: #f2f2f2;
  margin-top: 5px;
}

.historyBox .item{
  display: flex;
  flex-direction: column;
  height: 80px;
  background-color: #fafafa;
  margin-top: 1px;
}

.place{
  width: 5%;
  display: flex;
  align-items: center;
  margin-left: 10px;
  font-size: 18px;
  color: #f7a437;
}

.content{
  width: 80%;
  display: flex;  
  flex-direction: column;
  margin-left: 10px;
}

.content .history{
  /* height: 50px; */
  display: flex;  
  align-items: center;
  margin-left: 10px;
  margin-top: 8px;
  font-size: 21px;
  color: rgb(61, 61, 61);
}

.date{
  font-size: 13.5px;
  margin-left: 21%;
  color: rgb(218, 83, 6);
}
