/* pages/question/simple/simplequestion.wxss */
page{
  background: #f8f8f8;
}

.container{
  height: 100%;
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  box-sizing: border-box;
  background: #f5f5f5;
}

.container .content{

  width: 99%;
  background: #ffffff;
  border-radius: 9px;
  box-sizing: border-box;
}

.content .question{
  width: 97%;
  margin-top: 24px;
  margin-left: 5.5px;
  display: flex;
  justify-items: center;
  align-items: center;
  font-size: 22px;
  border-radius: 6px;
  background: #10cfe5;
}

.question text{
  margin-top: 15px;
  margin-bottom: 17px;
  margin-left: 12px;
  margin-right: 10px;
  color: rgb(252, 252, 252);
}

.content .answer{
  width: 97%;
  margin-top: 30px;
  margin-left: 5.5px;
  margin-bottom: 40px;
  display: flex;
  justify-items: center;
  align-items: center;
  font-size: 20px;
  border-radius: 6px;
  background: #f8f8f8;
  line-height: 30px;
}

.answer text{
  margin-top: 20px;
  margin-bottom: 20px;
  margin-left: 16px;
  margin-right: 16px;
  color: rgb(73, 73, 73);
}

.questionBox{
  margin-top: 15px;
  background: #ffffff;
  width: 99%;
  border-radius: 5px;
  display: flex;
  justify-items: center;
  flex-direction: column;
}

.questionBox .explain{
  height: 30px;
  width: 60%;
  margin-top: 20px;
  margin-left: 18px;
  font-size: 18px;
  color: #d40606;
}

.questionBox .item{
  width: 95%;
  margin-top: 10px;
  margin-bottom: 10px;
  margin-left: 10px;
  background: #f8f8f8;
}

.item .question{
  width: 95%;
  margin-top: 15px;
  margin-bottom: 15px;
  margin-left: 15px;
  margin-right: 15px;
  font-size: 19px;
  color: #353535;
}

.item .answer{
  width: 95%;
  margin-top: 15px;
  margin-bottom: 15px;
  margin-left: 28px;
  margin-right: 15px;
  font-size: 18px;
  color: #4e4e4e;
}